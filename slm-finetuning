_type":"code","source":"from transformers import (\nAutoTokenizer,\nAutoModelForCausalLM,\nBitsAndBytesConfig\n)\n\nMODEL_ID = \"Qwen/Qwen2.5-1.5B-Instruct\"\n\nbnb_config = BitsAndBytesConfig(\n    load_in_4bit=True,\n    bnb_4bit_quant_type=\"nf4\",\n    bnb_4bit_use_double_quant=True,\n    bnb_4bit_compute_dtype=torch.float16\n)\n\nprint(\"4-bit configuration created\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T16:01:14.79679Z","iopub.execute_input":"2026-11-08T16:01:14.797007Z","iopub.status.idle":"2026-11-08T16:01:14.80189Z","shell.execute_reply.started":"2026-11-08T16:01:14.796987Z","shell.execute_reply":"2026-11-08T16:01:14.80094Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### Model selection\n1. Qwen2.5-1.5B-Instruct is selected as the SLM for finetuning\n2. This is the best performing SLM with lesser parameters compared to other 3B, 7B, 8B parameter models\n3. Loads faster, fine-tuning is faster compared to other models\n4. The *Instruct* version model is trained to follow instructions, participate in coversations, provide assistant-style outputs etc.,\n5. This aligns with the expectation of the assignment. ","metadata":{}},{"cell_type":"code","source":"from transformers import AutoConfig\n\ntry:\n    config = AutoConfig.from_pretrained(MODEL_ID)\n    print(\"Model ID found\")\n    print(\"Model type: \", config.model_type)\n    print(\"Architecture: \", config.architectures)\n    \n    tokenizer = AutoTokenizer.from_pretrained(MODEL_ID)\n    \n    base_model = AutoModelForCausalLM.from_pretrained(\n        MODEL_ID,\n        quantization_config=bnb_config,\n        device_map={\"\":0}\n    )\n    \n    base_model.eval()\n    \n    print(base_model)\n    \n    print(\"Base Model Loaded Successfully\")\n    print(\"Base Model:\",MODEL_ID)\n    print(\"GPU:\", torch.cuda.get_device_name(0))\n    \nexcept Exception as e:\n    print(\" Model validation failed\", e)\n    \n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T16:01:14.803014Z","iopub.execute_input":"2026-11-08T16:01:14.80344Z","iopub.status.idle":"2026-11-08T16:01:16.868062Z","shell.execute_reply.started":"2026-11-08T16:01:14.803419Z","shell.execute_reply":"2026-11-08T16:01:16.867336Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"for dirname, _, filenames in os.walk('/kaggle/input'):\n    for filename in filenames:\n        print(os.path.join(dirname, filename))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T16:01:16.869093Z","iopub.execute_input":"2026-11-08T16:01:16.869456Z","iopub.status.idle":"2026-11-08T16:01:16.875404Z","shell.execute_reply.started":"2026-11-08T16:01:16.869406Z","shell.execute_reply":"2026-11-08T16:01:16.874505Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Finetuning preparations","metadata":{}},{"cell_type":"code","source":"#chat format preparation for finetuning dataset\n# prompt definition is done based on the dataset prepared.\n\ndef format_example(example):\n    messages = [\n        {\n            \"role\": \"system\",\n            \"content\": \"You are a banking customer support assistant\"\n        },\n        {\n            \"role\": \"user\",\n            \"content\": f\"{example['instruction']}\\n\\n{example['input']}\"\n        },\n        {\n            \"role\": \"assistant\",\n            \"content\": example['output']\n        }\n    ]\n\n    example[\"text\"] = tokenizer.apply_chat_template(messages, tokenize=False)\n\n    return example","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T16:01:16.876671Z","iopub.execute_input":"2026-11-08T16:01:16.877251Z","iopub.status.idle":"2026-11-08T16:01:16.89254Z","shell.execute_reply.started":"2026-11-08T16:01:16.877226Z","shell.execute_reply":"2026-11-08T16:01:16.891571Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from datasets import load_dataset\n\ndataset = load_dataset(\n    \"json\", \n    data_files=\"/kaggle/input/datasets/ravinanjaiah/banking-alpaca-dataset/banking_alpaca_dataset.jsonl\",\n    split=\"train\"\n)\n\nprint(dataset[0])\ndataset = dataset.map(format_example)\nprint(dataset[0][\"text\"])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T16:01:16.893713Z","iopub.execute_input":"2026-11-08T16:01:16.894137Z","iopub.status.idle":"2026-11-08T16:01:19.07854Z","shell.execute_reply.started":"2026-11-08T16:01:16.894114Z","shell.execute_reply":"2026-11-08T16:01:19.077717Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"print(dataset.column_names)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T16:01:19.07956Z","iopub.execute_input":"2026-11-08T16:01:19.080129Z","iopub.status.idle":"2026-11-08T16:01:19.084395Z","shell.execute_reply.started":"2026-11-08T16:01:19.080106Z","shell.execute_reply":"2026-11-08T16:01:19.083793Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def tokenize_function(examples):\n    return tokenizer(\n        examples[\"text\"],\n        truncation=True,\n        max_length=512,\n    )\n\ntokenized_dataset = dataset.map(\n    tokenize_function,\n    batched=True\n)\n\nprint(tokenized_dataset.column_names)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T16:01:19.085335Z","iopub.execute_input":"2026-11-08T16:01:19.085611Z","iopub.status.idle":"2026-11-08T16:01:21.149649Z","shell.execute_reply.started":"2026-11-08T16:01:19.08559Z","shell.execute_reply":"2026-11-08T16:01:21.148807Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### LoRA Configurations\n1. LoRA rank=16. Default configuration\n2. alpha=2: common configuration\n3. Drop out of 5% of LoRA activations during training\n4. biases are not trained\n5. task type is Language model: next-token prediction, auto-regressive generation\n6. LoRA adapters and Feed forward layers are also the target during training. Training feed forward makes the model learn the assistant style, tone, banking-specific language and refusal behavior","metadata":{}},{"cell_type":"code","source":"# LoRA configuration\n# Need to understand this configuration\nfrom peft import LoraConfig\nlora_config = LoraConfig(\n    r=16,\n    lora_alpha=32,\n    lora_dropout=0.05,\n    bias=\"none\",\n    task_type=\"CAUSAL_LM\",\n    target_modules=[\n        \"q_proj\",\n        \"k_proj\",\n        \"v_proj\",\n        \"o_proj\",\n        \"gate_proj\",\n        \"up_proj\",\n        \"down_proj\"\n    ]\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T16:01:21.150802Z","iopub.execute_input":"2026-11-08T16:01:21.15114Z","iopub.status.idle":"2026-11-08T16:01:21.155889Z","shell.execute_reply.started":"2026-11-08T16:01:21.151117Z","shell.execute_reply":"2026-11-08T16:01:21.155137Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from peft import get_peft_model\n\nft_model = get_peft_model(base_model, lora_config)\n\nft_model.print_trainable_parameters()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T16:01:21.156665Z","iopub.execute_input":"2026-11-08T16:01:21.156958Z","iopub.status.idle":"2026-11-08T16:01:21.684338Z","shell.execute_reply.started":"2026-11-08T16:01:21.156937Z","shell.execute_reply":"2026-11-08T16:01:21.683425Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### Configurations of \"Training Hyperparameters\"\n1. epochs = 3: common for instruction finetuning\n2. Training batch size = 4: good configuration for given GPU capabality\n3. Gradient accumulation every 4th batch\n4. fp16=True: Mixed precision training\n5. warmup steps is set to 15, this is ~3%\n6. print training parameters every 10 optimizer steps\n7. no reporting","metadata":{}},{"cell_type":"code","source":"print(transformers.__version__)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T16:01:21.685493Z","iopub.execute_input":"2026-11-08T16:01:21.685907Z","iopub.status.idle":"2026-11-08T16:01:21.69192Z","shell.execute_reply.started":"2026-11-08T16:01:21.685863Z","shell.execute_reply":"2026-11-08T16:01:21.691034Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Training Arguments\n\nfrom transformers import TrainingArguments\n\ntraining_args = TrainingArguments(\n    output_dir=\"./qwen-banking-lora\",\n    num_train_epochs=3,\n    per_device_train_batch_size=4,\n    gradient_accumulation_steps=4,\n    learning_rate=2e-4,\n    fp16=True,\n    save_strategy=\"epoch\",\n    logging_steps=10,\n    warmup_steps=15,\n    lr_scheduler_type=\"cosine\",\n    report_to=\"none\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T16:01:21.69335Z","iopub.execute_input":"2026-11-08T16:01:21.693759Z","iopub.status.idle":"2026-11-08T16:01:21.744147Z","shell.execute_reply.started":"2026-11-08T16:01:21.693704Z","shell.execute_reply":"2026-11-08T16:01:21.743548Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"#### Data Collator\nData Collator aligns the batch to same length as expected by GPU.\n- Pads shorter sequences\n- creates attention masks\n- combines examples into tensors\n- creates labels for training\nmlm=False indicates target is a casual language model","metadata":{}},{"cell_type":"code","source":"#Data Collator\nfrom transformers import DataCollatorForLanguageModeling\n\ndata_collator = DataCollatorForLanguageModeling(tokenizer=tokenizer, mlm=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T16:01:21.745151Z","iopub.execute_input":"2026-11-08T16:01:21.74546Z","iopub.status.idle":"2026-11-08T16:01:21.749445Z","shell.execute_reply.started":"2026-11-08T16:01:21.74543Z","shell.execute_reply":"2026-11-08T16:01:21.748792Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Create Trainer\nfrom transformers import Trainer\n\ntrainer = Trainer(\n    model=ft_model